# Shopify: mint a fresh token from the n8n workflow's "Get Shopify Token" step
# (Execute step -> copy access_token). Never commit the filled-in .env.
SHOPIFY_SHOP=slompoboutique.myshopify.com
SHOPIFY_TOKEN=

# Linear: Settings -> API -> Personal API key, for the sandbox workspace
LINEAR_API_KEY=

# Optional: how the brief signs itself in the channel
SLACK_BOT_NAME=catalogue-gate
SLACK_BOT_EMOJI=:vertical_traffic_light:
